{
  "name": "fdu-course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web 'node --env-file-if-exists=.env --import tsx --watch server/main.ts' 'vite --host 127.0.0.1'",
    "dev:connector": "node --env-file-if-exists=.env --import tsx connector/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "NODE_ENV=production vite build && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/server/server/main.js",
    "start:connector": "node dist/server/connector/main.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/database/migrate.ts",
    "db:backup": "bash scripts/backup.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:test": "concurrently -k -n api,web 'node --import tsx server/main.ts' 'vite --host 127.0.0.1 --port 5174'",
    "setup:local": "node scripts/setup-local.mjs",
    "dev:demo": "concurrently -k -n api,web 'node --import tsx scripts/demo-server.ts' 'vite --host 127.0.0.1'"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "fastify": "^5.12.3",
    "lucide-react": "^1.42.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
